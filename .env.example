# ─────────────────────────────────────────────────────────────────────────────
# Kalakriti — environment variable template
# Copy to .env.local for local dev. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Public (exposed to browser, prefix NEXT_PUBLIC_) ─────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kalakriti

# ── API ───────────────────────────────────────────────────────────────────────
# Internal backend base URL (server-side only, no NEXT_PUBLIC_)
# API_BASE_URL=https://api.kalakriti.in

# ── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=

# ── Auth (if added later) ─────────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=                        # openssl rand -base64 32
